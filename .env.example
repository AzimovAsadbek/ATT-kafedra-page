# Saytning to'liq manzili (SEO, Open Graph, sitemap uchun)
NEXT_PUBLIC_SITE_URL=https://axborot-texnologiyalari.netlify.app

# Ma'lumotlar bazasi. Lokal SQLite fayl yoki Turso (libsql://...) manzili
DATABASE_URL=file:./data/app.db
# Faqat Turso uchun
DATABASE_AUTH_TOKEN=

# Sessiya tokenlarini imzolash kaliti (kamida 32 belgi). Yaratish:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Birinchi administrator (faqat bazada administrator bo'lmaganda ishlatiladi)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Ixtiyoriy: yangi murojaatlar haqida Telegram orqali xabar olish
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
