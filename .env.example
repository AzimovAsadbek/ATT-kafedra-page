# Saytning to'liq manzili (SEO, Open Graph, sitemap uchun)
NEXT_PUBLIC_SITE_URL=https://axborot-texnologiyalari.netlify.app

# Ma'lumotlar bazasi (PostgreSQL).
# Lokal: `npm run db:up` (Docker) dan keyin quyidagi manzil ishlaydi.
# Production: Neon manzili (Vercel'da Storage → Neon integratsiyasi uni avtomatik qo'shadi).
DATABASE_URL=postgres://att:att@localhost:5432/att

# Sessiya tokenlarini imzolash kaliti (kamida 32 belgi). Yaratish:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Birinchi administrator (faqat bazada administrator bo'lmaganda ishlatiladi)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Ixtiyoriy: yangi murojaatlar haqida Telegram orqali xabar olish
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
